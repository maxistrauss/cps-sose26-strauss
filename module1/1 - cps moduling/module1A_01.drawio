                    <mxGeometry x="400" y="340" width="190" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2" parent="1" source="plant" target="sensors" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
