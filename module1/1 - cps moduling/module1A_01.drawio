                </mxCell>
                <mxCell id="a3" value="signal quality + vital features" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2" parent="1" source="sensors" target="control" edge="1">
                    <mxGeometry relative="1" as="geometry">
