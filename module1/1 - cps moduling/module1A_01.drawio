                    <mxGeometry x="635" y="340" width="190" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="fallback" value="Low confidence / poor signal -&gt; conservative threshold policy or re-measurement" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="205" y="245" width="270" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="a8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endFill=0;strokeWidth=1.5" parent="1" source="fallback" target="control" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="section1" value="&lt;b&gt;(b) Why model-based, learned, or hybrid?&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="40" y="430" width="350" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="t1" value="&lt;b&gt;Physical plant — Primarily model-based.&lt;/b&gt; Human physiology is governed by causal biological processes, so the system meaning of variables such as pulse, oxygen saturation, and temperature comes from physiology, not from a learned classifier alone. Simple physiology and signal-quality assumptions help define safe operating ranges and what counts as physically plausible data." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="40" y="458" width="360" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="&lt;b&gt;Sensing + alert interface — Hybrid.&lt;/b&gt; Sampling, calibration, and haptic-alert timing are mostly rule-based and hardware-driven, which makes them predictable and easy to validate. But learned denoising or motion-artifact suppression can improve PPG/ECG quality in daily-life conditions where pure signal-processing rules often fail." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="40" y="550" width="360" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="t3" value="&lt;b&gt;Communication / networking — Primarily model-based.&lt;/b&gt; BLE/Wi-Fi protocols, encryption, retry logic, and message scheduling should be deterministic because reliability and security matter more than adaptation here. ML may assist compression or prioritization, but the communication stack itself should remain standards-based and testable." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="40" y="642" width="360" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="t4" value="&lt;b&gt;ML components — Primarily learned.&lt;/b&gt; Activity recognition, sleep/stress inference, anomaly detection, and personalized risk prediction depend on patterns that are difficult to hand-code from first principles. ML is appropriate because it can exploit multimodal sensor data and user-specific context, especially for noisy, nonlinear relationships." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="425" y="458" width="360" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="t5" value="&lt;b&gt;Control logic — Hybrid.&lt;/b&gt; Safety-critical decisions such as emergency alerts, minimum confidence thresholds, and escalation to a clinician should remain rule-based so behavior is explainable. A learned model can provide risk scores or context, but the final policy should combine these outputs with deterministic thresholds, timers, and fail-safe checks." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="425" y="550" width="360" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="section2" value="&lt;b&gt;(c) Two verification / safety challenges from ML&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=15;fontStyle=1" parent="1" vertex="1">
                    <mxGeometry x="425" y="650" width="360" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="1. &lt;b&gt;Distribution shift:&lt;/b&gt; training data may not match real use (different skin tones, motion patterns, sensor placement, illness states), so accuracy can degrade unexpectedly in deployment." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="425" y="678" width="360" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="2. &lt;b&gt;Opaque decision boundaries:&lt;/b&gt; false alarms or missed anomalies may be hard to explain, making certification, debugging, and clinical trust more difficult than for a transparent threshold-based system." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11" parent="1" vertex="1">
                    <mxGeometry x="425" y="730" width="360" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="2" value="Edge Device: smartwatch + low-power AI accelerator" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="230" y="70" width="290" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="" style="shape=actor;whiteSpace=wrap;html=1;" parent="1" vertex="1">
