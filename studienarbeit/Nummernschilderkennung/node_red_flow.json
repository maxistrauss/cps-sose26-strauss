    {
        "id": "fe540758bce2bf27",
        "type": "function",
        "z": "f0a60e80c07767ec",
        "name": "Brain Logic (Entry/Exit)",
        "func": "let parkedCars = global.get('parkedCars') || [];\nlet detection = msg.payload;\nlet plate = detection.plate;\nlet camera = detection.camera;\n\nlet commandMsg = null;\n\nif (camera === \"entrance\") {\n    if (!parkedCars.includes(plate)) {\n        parkedCars.push(plate);\n        global.set('parkedCars', parkedCars);\n    }\n    commandMsg = {\n        topic: \"parking/entrance/barrier/command\",\n        payload: { command: \"OPEN\", plate: plate }\n    };\n} \nelse if (camera === \"exit\") {\n    if (parkedCars.includes(plate)) {\n        parkedCars = parkedCars.filter(c => c !== plate);\n        global.set('parkedCars', parkedCars);\n        commandMsg = {\n            topic: \"parking/exit/barrier/command\",\n            payload: { command: \"OPEN\", plate: plate }\n        };\n    }\n}\n\n// Update List for UI\nlet listMsg = { payload: parkedCars.map(p => ({plate: p})) };\n\nreturn [commandMsg, listMsg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 120,
        "wires": [
