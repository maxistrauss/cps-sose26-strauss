    {
        "id": "60b29258bd7732a0",
        "type": "function",
        "z": "f0a60e80c07767ec",
        "d": true,
        "name": "Post licence",
        "func": "// 1. Input-Daten aus dem MQTT-In Node extrahieren\nlet detection = msg.payload;\nlet plate = detection.plate;\nlet camera = detection.camera;\nlet timestamp = detection.timestamp;\n\n// 2. HTTP-Request-Objekt vorbereiten\nmsg.method = \"POST\";\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\n// 3. Logik-Unterscheidung nach Kamera/Schranke\nif (camera === \"entrance\") {\n    // Ziel-URL für das Einfahrts-Backend setzen\n    msg.url = \"http://localhost:8080/api/parking/entry\";\n\n    // Payload für die Datenbank-Sitzung und Event-Log (ENTRY_PLATE_DETECTED) schnüren\n    msg.payload = {\n        plate: plate,\n        camera: camera,\n        timestamp: timestamp,\n        eventType: \"ENTRY_PLATE_DETECTED\",\n        message: `Fahrzeug ${plate} an Einfahrt erkannt.`\n    };\n\n} else if (camera === \"exit\") {\n    // Ziel-URL für das Ausfahrts-Backend (inkl. Bezahl-Check) setzen\n    msg.url = \"http://localhost:8080/api/parking/exit\";\n\n    // Payload für den Bezahl-Check und Event-Log (EXIT_PLATE_DETECTED) schnüren\n    msg.payload = {\n        plate: plate,\n        camera: camera,\n        timestamp: timestamp,\n        eventType: \"EXIT_PLATE_DETECTED\",\n        message: `Fahrzeug ${plate} an Ausfahrt erkannt. Bezahlstatus wird geprüft.`\n    };\n} else {\n    // Fallback für unbekannte Kamera-IDs\n    node.warn(`Unbekannte Kamera-ID erkannt: ${camera}`);\n    return null;\n}\n\n// 4. Modifizierte Nachricht an den nächsten Node (HTTP Request) weiterleiten\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 500,
        "wires": [
            [
                "32dc35a6570223fc"
            ]
        ]
    },
    {
        "id": "04df05db0706cb52",
        "type": "function",
        "z": "f0a60e80c07767ec",
        "d": true,
        "name": "Check for valid licence",
        "func": "// 1. Die HTTP-Antwort vom Backend abgreifen\n// Wir erwarten vom Backend ein JSON wie: { \"access\": true, \"message\": \"Valid entry/payment\" }\nlet apiResponse = msg.payload; \nlet httpStatusCode = msg.statusCode;\n\n// Falls das Backend das Kennzeichen mitschickt, nutzen wir es, ansonsten Fallback auf das originale msg.payload.plate\nlet plate = apiResponse.plate || msg.payload.plate;\nlet camera = msg.payload.camera; // Wird aus dem vorherigen Zustand mitgeschleift\n\n// 2. Prüfen, ob der API-Call erfolgreich war (HTTP Status 200) und das Backend \"Grünes Licht\" gibt\nif (httpStatusCode === 200 && apiResponse.access === true) {\n    \n    // Dynamisch das richtige MQTT-Topic basierend auf der Kamera bestimmen\n    if (camera === \"entrance\") {\n        msg.topic = \"parking/entrance/barrier/command\";\n    } else if (camera === \"exit\") {\n        msg.topic = \"parking/exit/barrier/command\";\n    }\n\n    // Die Payload für den Schranken-Aktor schnüren\n    msg.payload = {\n        command: \"OPEN\",\n        plate: plate,\n        timestamp: new Date().toISOString()\n    };\n    \n    node.log(`Schrankenöffnung freigegeben für: ${plate} an ${camera}`);\n    return msg; // Nachricht weiterleiten an den \"MQTT Out\"-Node\n    \n} else {\n    // Falls das Backend den Zugriff verweigert (z.B. weil nicht bezahlt wurde)\n    node.warn(`Zufahrt/Ausfahrt verweigert für ${plate}. Grund: ${apiResponse.message || \"Unbekannter Fehler\"}`);\n    \n    // Optional: Du könntest hier eine Nachricht an ein Dashboard-Textfeld ausgeben\n    // Um den Flow hier abzubrechen, geben wir einfach null zurück\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1120,
        "y": 500,
        "wires": [
            [
                "1796ff1d744e86ea"
            ]
        ]
    },
