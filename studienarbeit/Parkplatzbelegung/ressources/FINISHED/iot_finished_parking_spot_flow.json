    {
        "id": "d5f6459e8107cdfb",
        "type": "function",
        "z": "71af189bd449e477",
        "name": "Define Sliding Window",
        "func": "const WINDOW_SIZE = 5;\n\n// Get existing window, or create empty one\nlet window = flow.get(\"sensorWindow\") || [];\n\n// Convert incoming payload to value\n// Example expected payload: true / false\nlet newValue = msg.payload.occupied;\n\n// Add newest value at the beginning\nwindow.unshift(newValue);\n\n// Remove oldest values if too long\nif (window.length > WINDOW_SIZE) {\n    window.pop();\n}\n\n// Save updated window\nflow.set(\"sensorWindow\", window);\n\n// Optional: expose window for debugging\nmsg.payload = {\n    latest: newValue,\n    window: window,\n    count: window.length,\n    full: window.length === WINDOW_SIZE\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 720,
        "wires": [
            [
                "eff32aa19bd199b9",
                "d14211db11149597"
            ]
        ]
    },
    {
        "id": "eff32aa19bd199b9",
        "type": "function",
        "z": "71af189bd449e477",
        "name": "Check Window to control LED",
        "func": "const THRESHOLD = 0.8;\n\n// Read sliding window\nlet window = flow.get(\"sensorWindow\") || [];\n\nif (window.length === 0) {\n    msg.payload = \"KEEP\";\n    return msg;\n}\n\nlet trueCount = window.filter(v => v === true).length;\nlet falseCount = window.filter(v => v === false).length;\n\nlet trueRatio = trueCount / window.length;\nlet falseRatio = falseCount / window.length;\n\nif (trueRatio >= THRESHOLD) {\n    msg.payload = \"RED\";\n} else if (falseRatio >= THRESHOLD) {\n    msg.payload = \"GREEN\";\n} else {\n    msg.payload = \"KEEP\";\n}\n\nmsg.debug = {\n    window,\n    trueCount,\n    falseCount,\n    trueRatio,\n    falseRatio\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1030,
        "y": 720,
        "wires": [
            [
                "d12a99d0d7afaec8"
            ]
        ]
    },
