    {
        "id": "729b01f2aa8d1efb",
        "type": "ui-template",
        "z": "3ee8989cd21f8d17",
        "group": "a5cc63c6f0f91a22",
        "page": "",
        "ui": "",
        "name": "Parkbelegung Dashboard",
        "order": 0,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"map-container\">\n    <img src=\"/images/Parkplatz_image_polished.png\" class=\"map-image\" />\n\n    <div\n      v-for=\"sensor in sensorList\"\n      :key=\"sensor.id\"\n      class=\"status-led\"\n      :class=\"getColor(sensor.id)\"\n      :style=\"{ left: sensor.x + '%', top: sensor.y + '%' }\"\n    ></div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      sensors: {},\n      sensorList: [\n        // ADD THE SENSOR NAMES HERE\n        // FLOWS OF EACH SENSOR SHOULD SEND THE DATA IN FORMAT: sensor1_GREEN, sensor2_RED, etc\n        { id: \"sensor1\", x: 87, y: 50 }/*,\n        { id: \"sensor2\", x: 65, y: 40 }*/\n      ]\n    }\n  },\n\n  watch: {\n    msg: {\n      handler(newMsg) {\n        if (!newMsg || !newMsg.payload) return\n\n        const parts = String(newMsg.payload).split(\"_\")\n        if (parts.length !== 2) return\n\n        const sensorId = parts[0]\n        const state = parts[1].toUpperCase()\n\n        this.sensors[sensorId] = state\n      },\n      deep: true\n    }\n  },\n\n  methods: {\n    getColor(sensorId) {\n      const state = this.sensors[sensorId] || \"GREEN\"\n      return state.toLowerCase()\n    }\n  }\n}\n</script>\n\n<style>\n.map-container {\n  position: relative;\n  width: 100%;\n}\n\n.map-image {\n  width: 100%;\n  display: block;\n}\n\n.status-led {\n  position: absolute;\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  transform: translate(-50%, -50%);\n  border: 2px solid black;\n  box-shadow: 0 0 8px black;\n  z-index: 10;\n}\n\n.status-led.green {\n  background-color: limegreen;\n}\n\n.status-led.red {\n  background-color: red;\n}\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
