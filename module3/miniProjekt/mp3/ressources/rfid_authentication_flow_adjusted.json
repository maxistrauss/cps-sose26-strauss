        "z": "5bd7793439aefeb5",
        "name": "Define Global list of UIDs",
        "func": "\n// stores all the uids\nglobal.set(\"allowedTags\", [\n    \"63c3afa9\"\n]);\n// checks if next uid should be stored\nglobal.set(\"storeNext\", false);\n\n// checks if next uid should be removed from list\nglobal.set(\"removeNext\", false);\n\nreturn msg;",
