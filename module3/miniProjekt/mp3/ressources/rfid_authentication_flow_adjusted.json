    {
        "id": "3ecfbddfffd8a690",
        "type": "function",
        "z": "5bd7793439aefeb5",
        "name": "Check UID",
        "func": "let allowed = global.get(\"allowedTags\") || [];\n\nif (allowed.includes(msg.payload)) {\n    msg.payload = \"FOUND\";\n} else {\n    msg.payload = \"NOT FOUND\";\n}\n\nreturn msg;",
