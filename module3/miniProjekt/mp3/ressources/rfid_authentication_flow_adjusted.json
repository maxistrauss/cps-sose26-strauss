    {
        "id": "d8cda95b1995ed10",
        "type": "function",
        "z": "5bd7793439aefeb5",
        "name": "Check if next UID should be stored",
        "func": "let store = global.get(\"storeNext\") || false;\nlet allowedTags = global.get(\"allowedTags\") || [];\n\nif (store) {\n    let tag = String(msg.payload).trim();\n\n    if (!allowedTags.includes(tag)) {\n        allowedTags.push(tag);\n    }\n\n    global.set(\"allowedTags\", allowedTags);\n    global.set(\"storeNext\", false);\n\n    node.warn(allowedTags);\n} else {\n    // do nothing\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 320,
        "wires": [
            [
                "05b81dfd546bf23f"
            ]
        ]
    },
    {
        "id": "05b81dfd546bf23f",
        "type": "function",
        "z": "5bd7793439aefeb5",
        "name": "Check if next UID should be stored",
        "func": "let remove = global.get(\"removeNext\") || false;\nlet allowedTags = global.get(\"allowedTags\") || [];\n\nif (remove) {\n    // Remove msg.payload from the list\n    allowedTags = allowedTags.filter(tag => tag !== msg.payload);\n\n    global.set(\"allowedTags\", allowedTags);\n    global.set(\"removeNext\", false);\n} else {\n    // do nothing\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
