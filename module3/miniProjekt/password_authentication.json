    {
        "id": "93d7492bc22b6115",
        "type": "function",
        "z": "17ce66ef60e52b02",
        "name": "function 1",
        "func": "// 1. Definiere das feste Passwort, falls es noch nicht im globalen Speicher existiert\nlet targetPassword = global.get(\"dashboardPassword\");\n\nif (!targetPassword) {\n    targetPassword = \"MeinSicheresPasswort123!\"; // <-- Hier dein gewünschtes Standard-Passwort eintragen\n    global.set(\"dashboardPassword\", targetPassword);\n}\n\n// 2. Eingehenden String (Passwort-Versuch) auslesen\n// Wir erwarten den String direkt in msg.payload\nconst inputPassword = msg.payload;\n\n// 3. Überprüfung durchführen\nif (inputPassword === targetPassword) {\n    // Passwort ist korrekt\n    msg.payload = {\n        authenticated: true,\n        message: \"Passwort korrekt.\"\n    };\n    // Sendet die Nachricht an den ersten Ausgang\n    return [msg, null];\n} else {\n    // Passwort ist falsch\n    msg.payload = {\n        authenticated: false,\n        message: \"Falsches Passwort.\"\n    };\n    // Sendet die Nachricht an den zweiten Ausgang (für Fehlermeldungen)\n    return [null, msg];\n}",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 120,
        "wires": [
